# Copy is created by: python scripts/dev/setup_secrets.py  (never commit .env)
# Native PostgreSQL uses port 5432; docker compose (docker-compose.yml) uses 5433.
DATABASE_URL=postgresql://mentor_pro_admin@127.0.0.1:5432/mentor_pro
# Automated tests and browser runs only (ADR-016): the name must end in "_test" and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://mentor_pro_admin@127.0.0.1:5432/mentor_pro_test
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mentor_pro
PGUSER=mentor_pro_admin
PGPASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter routing and budgets (ADR-009). Paid fallback is off unless explicitly enabled.
OPENROUTER_FREE_MODELS=
OPENROUTER_PAID_MODEL=
OPENROUTER_ALLOW_PAID=false
OPENROUTER_MAX_USD_PER_DAY=0
OPENROUTER_MAX_REQUESTS_PER_DAY=50
OPENROUTER_TIMEOUT_S=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_TOKENS=1024
# Output limit for question generation only (1000-16000); solve/review limits are fixed in code.
OPENROUTER_GENERATION_MAX_TOKENS=4000
# Models never used to generate questions (still used for blind solve and review).
OPENROUTER_GENERATION_EXCLUDED_MODELS=nvidia/nemotron-3.5-super-vl:free
# Optional reduced reasoning for generation: empty (off), minimal, low, medium or high.
# Sent only to models whose OpenRouter listing supports `reasoning`.
OPENROUTER_GENERATION_REASONING_EFFORT=
# Writing-exercise reviewers (ADR-029), primary first, then qualified fallbacks; empty = OPENROUTER_FREE_MODELS.
# The generator of an exercise is always excluded. Qualify a model with scripts/dev/benchmark_writing_reviewers.py.
OPENROUTER_WRITING_REVIEW_MODELS=
# Development-only endpoints (POST /api/dev/questions/generate). Never enable in production.
MENTOR_PRO_DEV_ENDPOINTS=false
# Practice sets (ADR-011, ADR-012): parallel slots (1-8) and per-set limits.
QUESTION_GENERATION_CONCURRENCY=2
MENTOR_PRO_SET_MAX_QUESTIONS=5
MENTOR_PRO_SET_MAX_REQUESTS_PER_SLOT=3
MENTOR_PRO_SET_MAX_CALLS=80
# Tutor review (/tutor, ADR-024): local tutor code, at least 16 characters; empty disables review.
MENTOR_PRO_TUTOR_TOKEN=
# Production tutor service only (python -m app.tutor_main, ADR-031): exact client IPs allowed, normally the
# compose bridge gateway; the token must then have at least 32 characters. Never set for the student app.
# MENTOR_PRO_TUTOR_ALLOWED_HOSTS=172.19.0.1
