# Copy is created by: python scripts/dev/setup_secrets.py  (never commit .env)
# Native PostgreSQL uses port 5432; docker compose (docker-compose.yml) uses 5433.
DATABASE_URL=postgresql://mentor_pro_admin@127.0.0.1:5432/mentor_pro
# Test suite only; the database name must end in "_test".
TEST_DATABASE_URL=postgresql://mentor_pro_admin@127.0.0.1:5432/mentor_pro_test
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mentor_pro
PGUSER=mentor_pro_admin
PGPASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter routing and budgets (ADR-009). Paid fallback is off unless explicitly enabled.
OPENROUTER_FREE_MODELS=
OPENROUTER_PAID_MODEL=
OPENROUTER_ALLOW_PAID=false
OPENROUTER_MAX_USD_PER_DAY=0
OPENROUTER_MAX_REQUESTS_PER_DAY=50
OPENROUTER_TIMEOUT_S=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_TOKENS=1024
# Development-only endpoints (POST /api/dev/questions/generate). Never enable in production.
MENTOR_PRO_DEV_ENDPOINTS=false
