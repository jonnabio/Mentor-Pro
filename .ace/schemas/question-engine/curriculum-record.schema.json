{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentor-pro.local/schemas/question-engine/curriculum-record.schema.json",
  "title": "CurriculumRecord",
  "description": "One node of the MEP PNE hierarchy extracted from a source document. text_es is verbatim source text; AI interpretations are kept separately. Schema 1.1 adds approved-baseline fields (ADR-006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "spec_version",
    "application",
    "subject",
    "ordinal",
    "text_es",
    "provenance",
    "source",
    "extraction",
    "review"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^PNE[0-9]{4}-PRI-(ESP|MAT|CIE|EST)-(DIAG|SUM|PE)(-B[0-9]+(-A[0-9]+(-E[0-9]+)?)?|-V-[a-z]+)$"
    },
    "record_type": {
      "enum": [
        "bloque",
        "afirmacion",
        "evidencia",
        "infinitivo_verbal"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "spec_version": {
      "type": "string",
      "pattern": "^PNE[0-9]{4}$"
    },
    "application": {
      "enum": [
        "diagnostica",
        "sumativa",
        "produccion_escrita"
      ]
    },
    "subject": {
      "enum": [
        "espanol",
        "matematicas",
        "ciencias",
        "estudios_sociales"
      ]
    },
    "ordinal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "text_es": {
      "type": "string",
      "minLength": 1
    },
    "item_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Cantidad de ítems (sumativa tables only)."
    },
    "provenance": {
      "enum": [
        "official",
        "secondary"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "file_name",
        "file_sha256",
        "page"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "table": {
          "type": "string"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "tool_version",
        "extracted_at"
      ],
      "properties": {
        "method": {
          "enum": [
            "pdf_text",
            "pdf_ocr",
            "docx",
            "xlsx",
            "manual"
          ]
        },
        "tool_version": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ai_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "model",
        "prompt_version"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      }
    },
    "baseline_version": {
      "type": "string",
      "pattern": "^PNE[0-9]{4}-[A-Z]+-v[0-9]+\\.[0-9]+$",
      "description": "Application curriculum baseline, e.g. PNE2026-SUM-v1.0."
    },
    "baseline_status": {
      "enum": [
        "approved",
        "withdrawn"
      ],
      "description": "Product-owner approval for use as grounding (ADR-006). Independent of provenance."
    },
    "verification_status": {
      "enum": [
        "unverified",
        "verified",
        "discrepancy"
      ],
      "description": "Comparison against official MEP wording."
    },
    "workbook_code": {
      "type": "string",
      "pattern": "^(EL|EE|M|C|ES)[0-9]{2}$",
      "description": "Stable user-facing objective code."
    },
    "assessment_type": {
      "enum": [
        "multiple_choice",
        "written_rubric"
      ]
    }
  }
}
