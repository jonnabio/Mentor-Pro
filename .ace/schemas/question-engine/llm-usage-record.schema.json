{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentor-pro.local/schemas/question-engine/llm-usage-record.schema.json",
  "title": "LlmUsageRecord",
  "description": "One LLM call. Contains no student data or prompt text. Costs in USD as reported by the provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "call_id",
    "request_id",
    "purpose",
    "attempt",
    "is_fallback",
    "model_requested",
    "model_used",
    "provider",
    "tier",
    "tokens_in",
    "tokens_out",
    "cost_usd",
    "cost_source",
    "latency_ms",
    "status",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "call_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "practice_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "enum": [
        "generation",
        "repair",
        "independent_solve",
        "review",
        "evaluation",
        "ingestion",
        "connectivity_test"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "is_fallback": {
      "type": "boolean"
    },
    "model_requested": {
      "type": "string"
    },
    "model_used": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "tier": {
      "enum": [
        "free",
        "paid",
        "unknown"
      ]
    },
    "tokens_in": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tokens_out": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_source": {
      "enum": [
        "provider_reported",
        "generation_endpoint",
        "missing"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "rate_limited",
        "timeout",
        "budget_blocked",
        "invalid_output"
      ]
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_kind": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stable failure code, e.g. http_429, timeout, connection."
    }
  }
}
