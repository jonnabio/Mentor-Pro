{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentor-pro.local/schemas/question-engine/validation-result.schema.json",
  "title": "ValidationResult",
  "description": "Outcome of question-quality-review for one item: deterministic checks, independent solve and rubric.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item_id", "checker_version", "deterministic_status", "checks", "requires_independent_solve", "verdict"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "item_id": { "type": "string" },
    "checker_version": { "type": "string" },
    "deterministic_status": { "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{2}$" },
          "status": { "enum": ["pass", "fail", "warn", "skip"] },
          "message": { "type": "string" }
        }
      }
    },
    "math_proven": { "type": "boolean", "description": "True only when the key was proven by exact arithmetic." },
    "requires_independent_solve": { "type": "boolean" },
    "independent_solve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed"],
      "properties": {
        "performed": { "type": "boolean" },
        "model_used": { "type": "string" },
        "chosen_label": { "type": ["string", "null"] },
        "agrees_with_key": { "type": ["boolean", "null"] }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": { "type": "integer", "minimum": 0, "maximum": 2 },
        "clarity": { "type": "integer", "minimum": 0, "maximum": 2 },
        "distractor_quality": { "type": "integer", "minimum": 0, "maximum": 2 },
        "language": { "type": "integer", "minimum": 0, "maximum": 2 },
        "difficulty_match": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "verdict": { "enum": ["accept", "revise", "regenerate", "reject", "pending"] },
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
