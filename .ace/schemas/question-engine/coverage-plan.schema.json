{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentor-pro.local/schemas/question-engine/coverage-plan.schema.json",
  "title": "CoveragePlan",
  "description": "Allocation of a practice-set request to evidencias, difficulty and task formats.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request",
    "slots",
    "coverage",
    "insufficient"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "plan_id": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "spec_version",
        "application",
        "target_ids",
        "difficulty",
        "question_count",
        "option_count",
        "scope",
        "baseline_version"
      ],
      "properties": {
        "subject": {
          "enum": [
            "espanol",
            "matematicas",
            "ciencias",
            "estudios_sociales"
          ]
        },
        "spec_version": {
          "type": "string"
        },
        "application": {
          "enum": [
            "diagnostica",
            "sumativa"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Afirmación or evidencia record IDs."
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "mixed"
          ]
        },
        "question_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "option_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "scope": {
          "enum": [
            "single_objective",
            "selected_objectives",
            "subject_simulation"
          ]
        },
        "baseline_version": {
          "type": "string"
        },
        "objective_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(EL|M|C|ES)[0-9]{2}$"
          },
          "description": "Workbook codes selected by the user; EE rubric codes are not allowed."
        },
        "coverage_strategy": {
          "enum": [
            "proportional_planned_items",
            "round_robin"
          ],
          "description": "Subject simulation allocation."
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "evidencia_id",
          "difficulty",
          "cognitive_verb",
          "task_format"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "evidencia_id": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "cognitive_verb": {
            "type": "string"
          },
          "task_format": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "evidencia_id -> number of slots."
    },
    "insufficient": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "reason"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
